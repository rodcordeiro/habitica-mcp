{
  "name": "habitica-rpg",
  "version": "0.2.0",
  "description": "Habitica daily execution layer: skill + MCP tools with confirm-gated writes.",
  "author": {
    "name": "Rodrigo Cordeiro",
    "url": "https://github.com/rodcordeiro"
  },
  "homepage": "https://github.com/rodcordeiro/habitica-mcp",
  "repository": "https://github.com/rodcordeiro/habitica-mcp",
  "license": "MIT",
  "keywords": ["habitica", "mcp", "productivity", "daily-execution"],
  "variables": {
    "type": "object",
    "properties": {
      "HABITICA_USER_ID": {
        "type": "string",
        "title": "Habitica User ID",
        "description": "User ID from Habitica Settings → API"
      },
      "HABITICA_API_TOKEN": {
        "type": "string",
        "title": "Habitica API Token",
        "description": "API token from Habitica Settings → API",
        "secret": true
      },
      "HABITICA_X_CLIENT": {
        "type": "string",
        "title": "Habitica x-client",
        "description": "Usually <user-id>-habitica-mcp"
      }
    },
    "required": ["HABITICA_USER_ID", "HABITICA_API_TOKEN", "HABITICA_X_CLIENT"]
  }
}
